{
    "name": "findair/erp-bff",
    "description": "Backend For Frontend (Slim 4) del ERP Findair: custodia tokens OAuth2 y hace de proxy hacia tmwe_json.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-sodium": "*",
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.5",
        "php-di/php-di": "^7.0",
        "predis/predis": "^2.2",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.14",
        "symfony/yaml": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.50",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Findair\\Bff\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Findair\\Bff\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": ["@cs", "@stan", "@test"]
    }
}
