# --- Aplicación ---------------------------------------------------------
APP_ENV=local                      # local | production
APP_URL=http://localhost:8080      # origen público de la SPA y del BFF (mismo sitio)
# 32 bytes aleatorios en base64:  php -r 'echo "base64:".base64_encode(random_bytes(32)),"\n";'
APP_KEY=

# --- Sesión -------------------------------------------------------------
REDIS_DSN=tcp://127.0.0.1:6379
SESSION_COOKIE=__Host-sid          # en local sin HTTPS usar "sid"
SESSION_IDLE_TTL=1800              # segundos de inactividad
SESSION_ABSOLUTE_TTL=43200         # segundos de vida máxima

# --- tmwe_json (backend) ------------------------------------------------
# URL interna que usa el BFF (red privada). Termina en app.php.
UPSTREAM_BASE_URL=http://127.0.0.1/erp/tmwe_json/app.php
# URL que ve el navegador al redirigir al login del backend (action=auth).
UPSTREAM_PUBLIC_URL=http://localhost/erp/tmwe_json/app.php
UPSTREAM_TIMEOUT=15
UPSTREAM_CONNECT_TIMEOUT=3
# Acción de tmwe_json que devuelve {user, capabilities} para /bff/auth/session. Vacía = se deducen
# de get_my_profile (provisional; ver docs/peticiones-backend.md §2).
UPSTREAM_CONTEXT_ACTION=get_ops_bootstrap

# Acciones de tmwe_json (admite *) a las que se bloquean las peticiones que cambian estado (403
# action_blocked). En local: bookings y cancelaciones con transportistas reales.
UPSTREAM_DENY_ACTIONS=

# --- Cliente OAuth2 confidencial registrado en tmwe_json ----------------
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8080/bff/auth/callback
OAUTH_SCOPE=
