# Copiar a .env.e2e (ignorado por git) y rellenar. Un perfil sin credenciales se omite.
# URL de la instalación a probar. Local por defecto; el sandbox (https://sandbox.erp.findair.it) es mucho más rápido
# que el API local con la BD por VPN (10-15 s por llamada) y es lo recomendado para estas pruebas.
E2E_BASE_URL=https://erp-findair.php8

# Personal TMWE (capabilities: tmwe, clients)
E2E_STAFF_USER=
E2E_STAFF_PASS=
# Partner real (capabilities: clients, my_org)
E2E_PARTNER_USER=
E2E_PARTNER_PASS=
# Cliente sin acceso al ERP (capabilities vacías)
E2E_SINACC_USER=
E2E_SINACC_PASS=

# Altas reales del partner (npm run test:alta). ESCRIBEN datos: confirmar antes que la base es de pruebas.
E2E_ALLOW_WRITE=
# Texto para buscar un cliente PROPIO del partner (p. ej. su razón social de pruebas)
E2E_PARTNER_CLIENT=
# Id de una expedición courier que YA tenga AWB (solo lectura; tests/staff/visor-etiquetas.spec.ts).
E2E_SHIPMENT_WITH_AWB=
# Exige el aviso «Required to print this block on the AWB» del campo País (1 cuando la SPA probada ya lo lleva).
E2E_AVISO_PAIS=
# Multiplica los plazos de espera (1 por defecto). Con un API lento (p. ej. BD remota por VPN) usar 4.
E2E_FACTOR_TIEMPO=
